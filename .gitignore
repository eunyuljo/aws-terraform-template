#################################################################
# Terraform
#################################################################

# Local .terraform directories
**/.terraform/*

# .tfstate files (state는 원격 backend로만 관리, 로컬에 저장하지 않음)
**/*.tfstate
**/*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Plan output files (민감한 정보 포함 가능)
*tfplan*
*.tfplan

# Override files (로컬 오버라이드용)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# 주의: .terraform.lock.hcl 은 commit 해야 함 (HashiCorp 공식 권장)
# - Provider 버전 고정으로 팀/CI 일관성 보장
# - 공급망 보안 (바이너리 hash 검증)

#################################################################
# Sensitive data (절대 commit 금지)
#################################################################

# Auto-loaded tfvars (민감 데이터 포함 가능성)
*.auto.tfvars
*.auto.tfvars.json

# 민감 변수 파일 (필요 시 example만 commit)
secrets.tfvars
*.secret.tfvars

# Backend 설정 (bucket 이름 등 환경별 민감 정보)
**/backend.hcl
!**/backend.hcl.example

# AWS credentials
.aws/
credentials
**/credentials.json

# SSH keys
*.pem
*.ppk
id_rsa*
id_ed25519*

# 환경 변수 파일
.env
.env.*
!.env.example

#################################################################
# Security scan / lint outputs
#################################################################

# Checkov
checkov-output/
results.sarif
.checkov.results.json

# tfsec
tfsec-results.json

# tflint
.tflint.d/

# terrascan
terrascan-results.json

#################################################################
# OS / Editor
#################################################################

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini

# Linux
*~

# JetBrains IDEs
.idea/
*.iml
*.iws

# VSCode (.vscode 디렉토리 자체는 팀 설정 공유용으로 commit, 개인 파일만 제외)
.vscode/*.local.json
.vscode/launch.json

# Vim
*.swp
*.swo
*~

#################################################################
# Misc
#################################################################

# 임시 파일
temp.sh
tmp/
*.tmp
*.bak

# 로그
*.log

# 압축 파일
*.zip
*.tar.gz
